# App
NODE_ENV=development
PORT=4000
API_PREFIX=api

# PostgreSQL (the user and database from the README setup step)
DATABASE_URL=postgresql://gbanjo:gbanjo@localhost:5432/gbanjo?schema=public

# Redis (used by BullMQ and the shared Redis client)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
# true when behind a reverse proxy / load balancer
TRUST_PROXY=false
# API docs at /api/docs (defaults to on outside production)
# SWAGGER_ENABLED=true

# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Google sign-in: OAuth "Web application" client from Google Cloud Console (also used as the mobile webClientId)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple sign-in: comma-separated iOS bundle ID (+ web Services ID if used)
APPLE_CLIENT_IDS=com.gbanjo.app
# Email (SMTP) — sign-up and reset codes, password-changed notices. Leave empty to print emails in the log.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_FROM="Gbanjo <no-reply@gbanjo.com>"
# Contact-page messages are emailed here (reply goes straight to the customer)
SUPPORT_EMAIL=support@gbanjo.com

# --- SMS (OTP codes) ---
# termii | emisri | console (console = print texts to the server log, for development)
SMS_PROVIDER=termii
# If the chosen gateway fails, try the other one (only if it's set up below)
SMS_FALLBACK_ENABLED=true
# Termii (https://termii.com) — base URL is on your Termii dashboard
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# dnd = reaches every number incl. DND (needed for OTPs; ask Termii to enable it) | generic
TERMII_CHANNEL=dnd
# Emisri (https://emisri.com)
EMISRI_API_KEY=
EMISRI_SENDER_ID=
EMISRI_BASE_URL=https://api.emisri.com/v1
EMISRI_EXCLUDE_DND=false
# Image uploads (Cloudinary dashboard → API Keys). Or set CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gbanjo
# Payments (Flutterwave dashboard → Settings → API keys). Without a secret key, card payments use a
# built-in test checkout page in development and are turned off in production.
FLW_SECRET_KEY=
# Flutterwave dashboard → Settings → Webhooks: set the URL to <API_PUBLIC_URL>/api/v1/payments/flutterwave/webhook
# and type any long random "Secret hash"; put the same value here.
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3
# Public address of this API (Flutterwave sends shoppers back here). On Render it defaults to the service URL.
API_PUBLIC_URL=http://localhost:4000
# Extra website origins allowed as "back to" pages after paying (CORS_ORIGINS are always allowed)
PAYMENT_RETURN_ORIGINS=
# Orders
SHIPPING_EXPRESS_FEE=12000
ORDER_PAYOUT_HOLD_DAYS=3
PLATFORM_FEE_PERCENT=0
# Withdrawals to banks (Flutterwave transfers; turn on Transfers in your Flutterwave dashboard)
WITHDRAWAL_MIN=1000
# Phone push notifications go through Expo. Only needed if "Enhanced push security" is on for your Expo project.
EXPO_ACCESS_TOKEN=
# One-time codes
OTP_LENGTH=4
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Development only: every code becomes this value (leave empty for random codes). Never set in production.
OTP_DEV_CODE=1234
