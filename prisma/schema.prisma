// Prisma schema. Models are PascalCase in code and snake_case in the database.
// After changing it run `npm run prisma:migrate -- --name <change>`.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// The person deleted their account (personal details are wiped; orders keep a "Deleted user").
  DELETED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  SOLD
}

enum SellerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ContactStatus {
  NEW
  RESOLVED
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum OrderStatus {
  /// Created at checkout; waiting for the card payment to go through. Hidden from order lists.
  AWAITING_PAYMENT
  ONGOING
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELED
}

enum PaymentPurpose {
  ORDER
  TOP_UP
}

enum WalletTxType {
  TOP_UP
  ORDER_PAYMENT
  REFUND
  SALE
  /// Money sent to the person's bank (negative), or put back when the transfer fails (positive).
  WITHDRAWAL
}

enum WalletTxStatus {
  /// Seller earnings on hold until the payout date (see ORDER_PAYOUT_HOLD_DAYS).
  PENDING
  COMPLETED
}

model User {
  id              String     @id @default(cuid())
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  /// Always stored lower-case.
  email           String     @unique
  /// E.164 format, e.g. +2349012345678. Null for Google/Apple accounts until they complete their profile.
  phone           String?    @unique
  /// Argon2id hash. Null until the user sets a password (mobile sign-up sets it after OTP).
  passwordHash    String?    @map("password_hash")
  avatarUrl       String?    @map("avatar_url")
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  /// Notification and privacy choices, e.g. {"orderUpdates":true,"offers":false}. Missing keys use the defaults.
  preferences     Json       @default("{}")
  deletedAt       DateTime?  @map("deleted_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions      Session[]
  oauthAccounts OAuthAccount[]
  wallet        Wallet?
  products      Product[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  sellerVerification SellerVerification?
  addresses     Address[]
  buyerConversations  Conversation[] @relation("ConversationBuyer")
  sellerConversations Conversation[] @relation("ConversationSeller")
  chatMessages        ChatMessage[]
  reviews             Review[]
  payments            Payment[]
  purchases           Order[]        @relation("OrderBuyer")
  sales               Order[]        @relation("OrderSeller")
  notifications       Notification[]
  pushTokens          PushToken[]
  reportsMade         Report[]       @relation("ReportReporter")
  reportsAgainst      Report[]       @relation("ReportTargetUser")
  blocking            Block[]        @relation("BlockBlocker")
  blockedBy           Block[]        @relation("BlockBlocked")
  bankAccount         BankAccount?
  withdrawals         Withdrawal[]

  @@map("users")
}

/// One row per signed-in device. The refresh token is `<session id>.<secret>`; only a SHA-256
/// of the secret is stored, and it rotates on every refresh.
model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @map("token_hash")
  /// Hash of the token that was rotated out, kept to detect refresh-token reuse.
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at")
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  expiresAt         DateTime  @map("expires_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// A Google / Apple identity linked to a user. `providerUserId` is the provider's stable `sub` claim.
model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  /// Email the provider reported when the account was linked (may be an Apple private relay address).
  email          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  lastUsedAt     DateTime      @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Every account gets one wallet (balance 0.00) when it's created.
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Every change to a wallet. `amount` is signed (+ money in, − money out). `reference` makes each change happen once.
model WalletTransaction {
  id          String         @id @default(cuid())
  walletId    String         @map("wallet_id")
  type        WalletTxType
  status      WalletTxStatus @default(COMPLETED)
  amount      Decimal        @db.Decimal(14, 2)
  /// Idempotency key, e.g. "topup:<payment ref>", "sale:<order id>".
  reference   String         @unique
  description String
  orderId     String?        @map("order_id")
  paymentId   String?        @map("payment_id")
  /// PENDING sale earnings move into the balance at this time.
  availableAt DateTime?      @map("available_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([status, availableAt])
  @@map("wallet_transactions")
}

/// One payment attempt: a checkout (paying for one or more orders) or a wallet top-up.
model Payment {
  id            String         @id @default(cuid())
  /// Our reference, sent to Flutterwave as tx_ref, e.g. "GBJ-M2X8K1-4F7A".
  reference     String         @unique
  userId        String         @map("user_id")
  purpose       PaymentPurpose
  /// card | bank-transfer | ussd (paid on Flutterwave) or wallet.
  method        String
  amount        Decimal        @db.Decimal(14, 2)
  currency      String         @default("NGN")
  status        PaymentStatus  @default(PENDING)
  /// "flutterwave", "test" (local test checkout) or "wallet".
  provider      String
  /// Flutterwave's transaction id once it's paid.
  providerTxId  String?        @map("provider_tx_id")
  checkoutUrl   String?        @map("checkout_url")
  /// Where to send the shopper after paying (website page or app link).
  returnUrl     String?        @map("return_url")
  failureReason String?        @map("failure_reason")
  paidAt        DateTime?      @map("paid_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

/// One seller's part of a checkout. Shipment stages: 0 confirmed, 1 packed, 2 shipped, 3 out for delivery, 4 delivered.
model Order {
  /// 8-digit order number shown to people, e.g. "92287157".
  id             String      @id
  buyerId        String      @map("buyer_id")
  /// Null for items sold by Gbanjo itself (an admin moves those along).
  sellerId       String?     @map("seller_id")
  paymentId      String      @map("payment_id")
  status         OrderStatus @default(AWAITING_PAYMENT)
  stage          Int         @default(0)
  /// When each stage was reached (index = stage).
  stageTimes     DateTime[]  @map("stage_times")
  recipient      String
  phone          String
  address        String
  email          String?
  /// standard | express
  shippingMethod String      @map("shipping_method")
  shippingFee    Decimal     @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  subtotal       Decimal     @db.Decimal(14, 2)
  discount       Decimal     @default(0) @db.Decimal(14, 2)
  total          Decimal     @db.Decimal(14, 2)
  voucherCode    String?     @map("voucher_code")
  etaFrom        DateTime    @map("eta_from")
  etaTo          DateTime    @map("eta_to")
  paidAt         DateTime?   @map("paid_at")
  deliveredAt    DateTime?   @map("delivered_at")
  canceledAt     DateTime?   @map("canceled_at")
  /// buyer | seller | admin | system
  canceledBy     String?     @map("canceled_by")
  /// card | wallet — where the refund went.
  refundTo       String?     @map("refund_to")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  buyer   User        @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User?       @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  payment Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([paymentId])
  @@map("orders")
}

/// What was bought, copied at checkout so later edits to the listing don't change the order.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String  @map("order_id")
  productId   String? @map("product_id")
  /// The product's URL name at checkout (used for links).
  productSlug String  @map("product_slug")
  name        String
  option      String  @default("")
  imageUrl    String  @map("image_url")
  price       Decimal @db.Decimal(14, 2)
  qty         Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Discount codes typed at checkout, e.g. GBANJO10 = 10% off the items.
model Voucher {
  code       String    @id
  percentOff Int       @map("percent_off")
  active     Boolean   @default(true)
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("vouchers")
}

model Category {
  id        String   @id @default(cuid())
  /// URL name, e.g. "home-decor".
  slug      String   @unique
  name      String
  /// Short line under the name, e.g. "Furniture & everyday living".
  blurb     String   @default("")
  imageUrl  String   @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  /// URL name, e.g. "olive-low-top-sneakers".
  slug        String        @unique
  name        String
  description String?
  price       Decimal       @db.Decimal(14, 2)
  /// Price before the discount; set together with flashSaleEndsAt for a flash sale.
  oldPrice    Decimal?      @map("old_price") @db.Decimal(14, 2)
  categoryId  String        @map("category_id")
  /// Small line on the card, e.g. "Clothing · Footwear".
  tags        String        @default("")
  location    String
  imageUrl    String        @map("image_url")
  /// Extra photos for the detail page.
  gallery     String[]
  /// Options such as colours and sizes.
  variations  String[]
  /// e.g. "Size S · Like new".
  condition   String?
  rating      Decimal       @default(0) @db.Decimal(2, 1)
  reviewCount Int           @default(0) @map("review_count")
  status      ProductStatus @default(ACTIVE)
  sellerId    String?       @map("seller_id")
  /// Seller listings: brand, price negotiable, delivery option ("buyer-pays" | "i-deliver" | "pickup").
  brand       String?
  negotiable  Boolean       @default(false)
  delivery    String?
  /// In the flash sale until this time.
  flashSaleEndsAt DateTime? @map("flash_sale_ends_at")
  /// Editorial boost for "Just For You" (higher shows first).
  featuredScore   Int       @default(0) @map("featured_score")
  /// Taken down by an admin: the seller can't publish it again.
  removedByAdmin  Boolean   @default(false) @map("removed_by_admin")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seller        User?          @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  conversations Conversation[]
  reviews       Review[]
  orderItems    OrderItem[]
  reports       Report[]

  @@index([categoryId, status])
  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([flashSaleEndsAt])
  @@map("products")
}

/// Home-page hero slides. Managed by admins (web: /admin/banners).
model Banner {
  id              String    @id @default(cuid())
  /// Small pill above the title, e.g. "Happening Now".
  eyebrow         String?
  title           String
  /// Big line under the title, e.g. "Up to 50%".
  highlight       String?
  subtitle        String?
  ctaLabel        String?   @map("cta_label")
  /// Where the button goes, e.g. "/products?category=clothing".
  ctaHref         String?   @map("cta_href")
  imageUrl        String    @map("image_url")
  /// Shown behind/around the image while it loads, e.g. "#f8b91b".
  backgroundColor String    @default("#f8b91b") @map("background_color")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  /// Optional schedule: only shown between these times.
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("banners")
}

/// Messages from the Contact page. Each one is also emailed to SUPPORT_EMAIL.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  topic     String
  orderRef  String?       @map("order_ref")
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  ipAddress String?       @map("ip_address")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

/// A product a signed-in user saved for later.
model WishlistItem {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

/// One line in a signed-in user's cart (one line per product).
model CartItem {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  /// Chosen option, e.g. "Pink, Size M".
  option    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("cart_items")
}

/// A seller's identity check (one per user; resubmitting replaces it). Sellers can list while PENDING.
model SellerVerification {
  id               String                   @id @default(cuid())
  userId           String                   @unique @map("user_id")
  /// nin | cac | drivers-license | voters-card | passport
  idType           String                   @map("id_type")
  /// Private Cloudinary asset (id-documents folder). Null only when uploads aren't configured.
  documentPublicId String?                  @map("document_public_id")
  status           SellerVerificationStatus @default(PENDING)
  /// Why it was rejected (shown to the seller).
  note             String?
  reviewedAt       DateTime?                @map("reviewed_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("seller_verifications")
}

/// A saved delivery address. Exactly one per user is the default (used in the header, cart and checkout).
model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// e.g. "Home", "Work"
  label     String
  /// Who receives the delivery
  name      String
  /// +234XXXXXXXXXX
  phone     String
  address   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// A chat between a buyer and the seller about one listing (one conversation per buyer per listing).
model Conversation {
  id        String  @id @default(cuid())
  productId String? @map("product_id")
  buyerId   String  @map("buyer_id")
  sellerId  String  @map("seller_id")
  /// Time of the latest message (for sorting the inbox).
  lastMessageAt    DateTime  @default(now()) @map("last_message_at")
  /// Everything up to these times has been read by that side.
  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  product  Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyer    User          @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User          @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([productId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  text           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// A shopper's star rating (1–5) and comment on a product. One per user per product; editing replaces it.
/// Product.rating / reviewCount are recalculated from these whenever one changes.
model Review {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Int
  text      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
  @@map("reviews")
}


/// In-app notification (the bell / Notifications screen). Also sent as a phone push when the person allows it.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  /// order | payment | seller | message | withdrawal | account
  type      String
  title     String
  body      String
  /// Where tapping it goes, e.g. "/orders/92287157" (same path on the website and in the app).
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// An Expo push token for one of the person's phones.
model PushToken {
  token      String   @id
  userId     String   @map("user_id")
  /// ios | android
  platform   String?
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

/// Someone flagging a listing or a person for the admins to look at.
model Report {
  id           String       @id @default(cuid())
  reporterId   String       @map("reporter_id")
  /// product | user
  targetType   String       @map("target_type")
  productId    String?      @map("product_id")
  targetUserId String?      @map("target_user_id")
  /// scam | fake | prohibited | offensive | other
  reason       String
  details      String       @default("")
  status       ReportStatus @default(OPEN)
  /// What the admin did / decided.
  note         String?
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  targetUser User?    @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("reports")
}

/// The blocker won't get messages from the blocked person (and can't message them).
model Block {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// Where the person's withdrawals are sent (one saved account; saving again replaces it).
model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  bankCode      String   @map("bank_code")
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  /// Name the bank returned for the account number.
  accountName   String   @map("account_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

/// Wallet money sent to a bank account through Flutterwave transfers.
model Withdrawal {
  id                 String           @id @default(cuid())
  userId             String           @map("user_id")
  /// Our transfer reference, e.g. "WDR-MGQ3K2X1-8F2A9C".
  reference          String           @unique
  amount             Decimal          @db.Decimal(14, 2)
  bankCode           String           @map("bank_code")
  bankName           String           @map("bank_name")
  accountNumber      String           @map("account_number")
  accountName        String           @map("account_name")
  status             WithdrawalStatus @default(PENDING)
  /// "flutterwave" or "test".
  provider           String
  providerTransferId String?          @map("provider_transfer_id")
  failureReason      String?          @map("failure_reason")
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("withdrawals")
}
